+			el.dispatchEvent(new Event('change', { bubbles: true }));
+		}
+
+		function download(text) {
+			var blob = new Blob([ text ], { type: 'text/plain;charset=utf-8' });
+			var url = URL.createObjectURL(blob);
+			var link = E('a', { 'href': url, 'download': 'split-tunnel-domains.txt' });
+			document.body.appendChild(link);
+			link.click();
+			document.body.removeChild(link);
+			window.setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+		}
+
+		var fileInput = E('input', {
+			'type': 'file',
+			'accept': '.txt,text/plain',
+			'style': 'display:none'
+		});
+
+		fileInput.addEventListener('change', function () {
+			var file = fileInput.files && fileInput.files[0];
+			if (!file)
+				return;
+			var reader = new FileReader();
+			reader.onload = function () {
+				setArea(String(reader.result || ''));
+				fileInput.value = '';
+				ui.addNotification(null, E('p',
+					_('Imported %s — press "Save & Apply" to apply.').format(file.name)),
+					'info');
+			};
+			reader.readAsText(file);
+		});
+
+		var importButton = E('button', {
+			'class': 'cbi-button cbi-button-action',
+			'type': 'button',
+			'click': function () { fileInput.click(); }
+		}, _('Import file'));
+
+		var exportButton = E('button', {
+			'class': 'cbi-button',
+			'type': 'button',
+			'click': function () {
+				var el = area();
+				var text = el ? normalizeDomains(el.value) : '';
+				if (text.length) {
+					download(text + '\n');
+					return;
+				}
+				fs.exec('/usr/bin/fptn-client-rs', [ '--print-split-tunnel-domains' ])
+					.then(function (res) {
+						download(res.stdout || '');
+					}).catch(function () {
+						ui.addNotification(null, E('p',
+							_('Unable to read the built-in list.')), 'error');
+					});
+			}
+		}, _('Export file'));
+
+		var repoButton = E('button', {
+			'class': 'cbi-button cbi-button-action',
+			'type': 'button',
+			'click': function () {
+				repoButton.disabled = true;
+				fetch(repoDomainsUrl, { cache: 'no-store' })
+					.then(function (res) {
+						if (!res.ok)
+							throw new Error('HTTP ' + res.status);
+						return res.text();
+					})
+					.then(function (text) {
+						var list = normalizeDomains(text);
+						setArea(list);
+						ui.addNotification(null, E('p',
+							_('Downloaded %s domains from the repository — press "Save & Apply" to apply.')
+								.format(list.length ? list.split('\n').length : 0)),
+							'info');
+					})
+					.catch(function (err) {
+						ui.addNotification(null, E('p',
+							_('Unable to download the domain list: %s')
+								.format(err && err.message ? err.message : err)),
+							'error');
+					})
+					.then(function () {
+						repoButton.disabled = false;
+					});
+			}
+		}, _('Download from repo'));
+
+		var deleteButton = E('button', {
+			'class': 'cbi-button cbi-button-negative',
+			'type': 'button',
+			'click': function () {
+				setArea('');
+				ui.addNotification(null, E('p',
+					_('The custom list is cleared — press "Save & Apply" to ' +
+					'revert to the built-in list.')), 'info');
+			}
+		}, _('Delete list'));
+
+		return E('div', {}, [
+			node,
+			E('div', {
+				'style': 'margin-top:.4em;display:flex;gap:.5em;flex-wrap:wrap;align-items:center'
+			}, [ importButton, exportButton, repoButton, deleteButton, fileInput ])
+		]);
+	};
+
+	return o;
+}
