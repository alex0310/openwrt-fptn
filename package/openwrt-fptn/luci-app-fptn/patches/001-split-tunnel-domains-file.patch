+// Collapse a block of text into a normalized domain list: trimmed lines,
+// empty lines dropped, LF line endings.
+function normalizeDomains(value) {
+	return (value || '').split(/\r?\n/).map(function (line) {
+		return line.trim();
+	}).filter(function (line) {
+		return line.length > 0;
+	}).join('\n');
+}
+
+// File-backed editor for the split-tunnel domain list, with Import / Export /
+// Delete buttons. The list is stored in splitDomainsFile; an empty value
+// removes the file so the client reverts to its built-in list.
+function splitDomainsOption(section, tab, title, description, placeholder) {
+	var o = section.taboption(tab, form.TextValue, '_split_tunnel_domains',
+		title, description);
+
+	o.rows = 15;
+	o.placeholder = placeholder;
+	o.rmempty = true;
+	o.monospace = true;
+
+	o.cfgvalue = function () {
+		return (splitDomainsContent != null) ? splitDomainsContent : '';
+	};
+
+	o.write = function (sid, value) {
+		var text = normalizeDomains(value);
+		splitDomainsContent = text.length ? text + '\n' : '';
+		return fs.write(splitDomainsFile, splitDomainsContent);
+	};
+
+	o.remove = function () {
+		splitDomainsContent = '';
+		return fs.remove(splitDomainsFile).catch(function () {});
+	};
+
+	o.renderWidget = function (section_id, option_index, cfgvalue) {
+		var node = form.TextValue.prototype.renderWidget.call(this,
+			section_id, option_index, cfgvalue);
+
+		var areaId = this.cbid(section_id);
+
+		function area() {
+			var frame = document.getElementById(areaId);
+			return frame ? frame.firstElementChild : null;
+		}
+
+		function setArea(text) {
+			var el = area();
+			if (!el)
+				return;
+			el.value = text;
+			// Mark the widget dirty and update the "unsaved changes" state.
+			el.dispatchEvent(new Event('change', { bubbles: true }));
+		}
+
+		function download(text) {
+			var blob = new Blob([ text ], { type: 'text/plain;charset=utf-8' });
+			var url = URL.createObjectURL(blob);
+			var link = E('a', { 'href': url, 'download': 'split-tunnel-domains.txt' });
+			document.body.appendChild(link);
+			link.click();
+			document.body.removeChild(link);
+			window.setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
+		}
+
+		var fileInput = E('input', {
+			'type': 'file',
+			'accept': '.txt,text/plain',
+			'style': 'display:none'
+		});
+
+		fileInput.addEventListener('change', function () {
+			var file = fileInput.files && fileInput.files[0];
+			if (!file)
+				return;
+			var reader = new FileReader();
+			reader.onload = function () {
+				setArea(String(reader.result || ''));
+				fileInput.value = '';
+				ui.addNotification(null, E('p',
+					_('Imported %s — press "Save & Apply" to apply.').format(file.name)),
+					'info');
+			};
+			reader.readAsText(file);
+		});
+
+		var importButton = E('button', {
+			'class': 'cbi-button cbi-button-action',
+			'type': 'button',
+			'click': function () { fileInput.click(); }
+		}, _('Import file'));
+
+		var exportButton = E('button', {
+			'class': 'cbi-button',
+			'type': 'button',
+			'click': function () {
+				var el = area();
+				var text = el ? normalizeDomains(el.value) : '';
+				if (text.length) {
+					download(text + '\n');
+					return;
+				}
+				fs.exec('/usr/bin/fptn-client-rs', [ '--print-split-tunnel-domains' ])
+					.then(function (res) {
+						download(res.stdout || '');
+					}).catch(function () {
+						ui.addNotification(null, E('p',
+							_('Unable to read the built-in list.')), 'error');
+					});
+			}
+		}, _('Export file'));
+
+		var deleteButton = E('button', {
+			'class': 'cbi-button cbi-button-negative',
+			'type': 'button',
+			'click': function () {
+				setArea('');
+				ui.addNotification(null, E('p',
+					_('The custom list is cleared — press "Save & Apply" to ' +
+					'revert to the built-in list.')), 'info');
+			}
+		}, _('Delete list'));
+
+		return E('div', {}, [
+			node,
+			E('div', {
+				'style': 'margin-top:.4em;display:flex;gap:.5em;flex-wrap:wrap;align-items:center'
+			}, [ importButton, exportButton, deleteButton, fileInput ])
+		]);
+	};
+
+	return o;
+}
