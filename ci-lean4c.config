CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_xiaomi_mi-router-4c=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Rust client (prebuilt binary staged by the workflow). It replaces
# fptn-client-slim: the two CONFLICT, and fptn-client-rs PROVIDES fptn-client so
# luci-app-fptn keeps working. The Rust client has no C++ runtime deps, so the
# boost/googletest packages the C++ client needed are gone.
CONFIG_PACKAGE_fptn-client-rs=y
