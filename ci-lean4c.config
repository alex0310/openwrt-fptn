CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt76x8=y
CONFIG_TARGET_ramips_mt76x8_DEVICE_xiaomi_mi-router-4c=y
# Do NOT set CONFIG_TARGET_MULTI_PROFILE=y here. In the generated kconfig it is a
# member of the *same* `choice` block as the device symbols above (see
# scripts/target-metadata.pl), so enabling it deselects the device, leaves
# CONFIG_TARGET_PROFILE empty and `make defconfig` produces a config that builds
# no image at all. The multi-device path uses the separate CONFIG_TARGET_DEVICE_*
# family, which lives outside that choice — but we only need one image here.
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Rust client (prebuilt binary staged by the workflow). It replaces
# fptn-client-slim: the two CONFLICT, and fptn-client-rs PROVIDES fptn-client so
# luci-app-fptn keeps working. The Rust client has no C++ runtime deps, so the
# boost/googletest packages the C++ client needed are gone.
CONFIG_PACKAGE_fptn-client-rs=y
